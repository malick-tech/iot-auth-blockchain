# ============================================================
#  Fichier d'exemple des variables d'environnement du projet
#  Copier en .env (exclu du git par .gitignore) et adapter.
# ============================================================

# ── Base de données PostgreSQL ───────────────────────────────
DB_USERNAME=malick
DB_PASSWORD=1234
PGADMIN_DEFAULT_PASSWORD=admin

# ── Clé privée Ed25519 de l'admin (32 octets en Base64)
# Signe tous les JWT PoP et Verifiable Credentials.
# Générer avec (PowerShell) :
#   $rng = [System.Security.Cryptography.RNGCryptoServiceProvider]::new()
#   $b = New-Object byte[] 32; $rng.GetBytes($b); [Convert]::ToBase64String($b)
IOT_AUTH_ADMIN_PRIVATE_KEY_BASE64=gMjREF3yWSR33vwK82tMfnZnT7Y8JbI9pSpoEbSnmJw=

# ── Secret JWT admin (64 octets en Base64)
# Signe les sessions de la console d'administration.
# Générer avec (PowerShell) :
#   $b = New-Object byte[] 64; $rng.GetBytes($b); [Convert]::ToBase64String($b)
IOT_AUTH_ADMIN_JWT_SECRET=zecuuGUM/4a4VjAlfVFr6dzeWfZ4okZwW29lca/eJPb8hXU3DsnccyzABEaHJuC7UCM4fn+UgzkKd5dNKqWnLw==

# ── Secret partagé Gateway ↔ Backend ────────────────────────
# Doit être IDENTIQUE dans Spring Boot et Node-RED.
# Utilisé par GatewayAuthFilter pour authentifier les logs cache-HIT.
# Valeur par défaut acceptée en dev local — changer en prod.
IOT_AUTH_GATEWAY_SHARED_SECRET=dev-local-gateway-secret-change-in-prod

# ── Algorand ─────────────────────────────────────────────────
ALGORAND_APP_ID=1010
ALGORAND_ALGOD_TOKEN=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
ALGORAND_DEPLOYER_MNEMONIC=
ALGORAND_INDEXER_TOKEN=
