# ============================================================
#  Fichier d'exemple des variables d'environnement du projet
#  Copier en .env (exclu du git par .gitignore) et adapter.
#
#  IMPORTANT : Ne jamais commit le fichier .env avec de vraies valeurs.
#  Les valeurs ci-dessous sont des EXEMPLES — les remplacer avant utilisation.
# ============================================================

# ── Base de données PostgreSQL ───────────────────────────────
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME

# ── Clé privée Ed25519 de l'admin (32 octets en Base64)
# Signe tous les JWT PoP et Verifiable Credentials.
# Générer avec :
#   PowerShell : $b = New-Object byte[] 32; [System.Security.Cryptography.RandomNumberGenerator]::Fill($b); [Convert]::ToBase64String($b)
#   Linux/Mac  : openssl rand -base64 32
IOT_AUTH_ADMIN_PRIVATE_KEY_BASE64=CHANGE_ME

# ── Secret JWT admin (64 octets en Base64)
# Signe les sessions de la console d'administration.
# Générer avec :
#   PowerShell : $b = New-Object byte[] 64; [System.Security.Cryptography.RandomNumberGenerator]::Fill($b); [Convert]::ToBase64String($b)
#   Linux/Mac  : openssl rand -base64 64
IOT_AUTH_ADMIN_JWT_SECRET=CHANGE_ME

# ── Secret partagé Gateway ↔ Backend ────────────────────────
# Doit être IDENTIQUE dans Spring Boot et Node-RED.
# Utilisé par GatewayAuthFilter pour authentifier les logs cache-HIT.
# Générer avec : openssl rand -hex 32
IOT_AUTH_GATEWAY_SHARED_SECRET=CHANGE_ME

# ── Algorand ─────────────────────────────────────────────────
# App ID du smart contract déployé sur le réseau cible
ALGORAND_APP_ID=CHANGE_ME
# Token d'authentification du noeud algod (localnet : 64 'a' par défaut)
ALGORAND_ALGOD_TOKEN=CHANGE_ME
# Mnemonic 25 mots du compte admin qui a déployé le contrat
ALGORAND_DEPLOYER_MNEMONIC=CHANGE_ME
# Token indexer (vide si non utilisé)
ALGORAND_INDEXER_TOKEN=
